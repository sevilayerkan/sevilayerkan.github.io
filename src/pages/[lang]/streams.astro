---
import type { GetStaticPaths } from "astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import XPWindow from "../../components/xp/XPWindow.astro";
import XPButton from "../../components/xp/XPButton.astro";
import StreamCard from "../../components/xp/StreamCard.astro";
import { streamingLinks } from "../../config/site";
import { isLocale, localeStaticPaths, localizeHref, ui } from "../../i18n";

export const getStaticPaths = (() => localeStaticPaths()) satisfies GetStaticPaths;

const lang = isLocale(Astro.params.lang) ? Astro.params.lang : "en";
const t = ui(lang).streams;
const platforms = streamingLinks();
---

<BaseLayout title={t.title} description={t.metaDescription}>
  <div class="page-stack streams-page">
    <XPWindow title={t.title}>
      <div class="streams-intro">
        <p class="streams-intro__eyebrow">{t.eyebrow}</p>
        <h1>{t.title}</h1>
        <p>{t.intro}</p>
      </div>
    </XPWindow>

    <XPWindow title={t.watch}>
      <div class="stream-platforms">
        {
          platforms.map((platform) => (
            <XPButton href={platform.href} external>
              {t[platform.key]} · {platform.handle}
            </XPButton>
          ))
        }
      </div>
    </XPWindow>

    <XPWindow title={t.recent}>
      <div class="streams-grid">
        {
          t.sessions.map((stream) => (
            <div class="streams-grid__item">
              <StreamCard
                title={stream.title}
                category={stream.category}
                description={stream.description}
                date={stream.date}
                status={stream.status}
              />
            </div>
          ))
        }
      </div>
    </XPWindow>

    <div class="streams-split">
      <XPWindow title={t.usual}>
        <div class="topics">
          <p>{t.usualIntro}</p>
          <ul>
            {
              t.topics.map((topic) => (
                <li>
                  <span aria-hidden="true">▶</span>
                  {topic}
                </li>
              ))
            }
          </ul>
        </div>
      </XPWindow>

      <XPWindow title={t.toNotes}>
        <div class="topics">
          <p>{t.toNotesBody}</p>
          <XPButton href={localizeHref(lang, "/blog")}>{t.readNotes}</XPButton>
        </div>
      </XPWindow>
    </div>
  </div>
</BaseLayout>

<style>
  .streams-intro,
  .topics {
    padding: 8px clamp(2px, 3vw, 24px);
  }

  .streams-intro__eyebrow {
    margin: 0 0 8px;
    color: var(--xp-heading);
    font-size: 13px;
    font-weight: 700;
  }

  .streams-intro h1 {
    margin: 0 0 12px;
    font-size: clamp(28px, 5vw, 44px);
    line-height: 1.05;
  }

  .streams-intro p,
  .topics p {
    max-width: 720px;
    margin: 0 0 16px;
    color: var(--xp-muted-text);
    line-height: 1.65;
  }

  .streams-intro p:last-child,
  .topics p:last-child {
    margin-bottom: 0;
  }

  .stream-platforms {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    padding: 8px clamp(2px, 3vw, 24px);
  }

  .streams-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 16px;
    padding: 4px;
  }

  .streams-grid__item {
    padding: 14px;
    border: 1px solid var(--xp-border-mid);
    background: var(--xp-content-bg);
  }

  .streams-split {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: 24px;
    align-items: start;
  }

  .topics ul {
    margin: 0 0 18px;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 9px;
  }

  .topics li {
    display: flex;
    align-items: center;
    gap: 9px;
    font-size: 14px;
  }

  .topics li span {
    color: var(--xp-caption);
    font-size: 11px;
  }

  @media (max-width: 900px) {
    .streams-grid,
    .streams-split {
      grid-template-columns: 1fr;
    }
  }
</style>

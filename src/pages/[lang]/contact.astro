---
import type { GetStaticPaths } from "astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import XPWindow from "../../components/xp/XPWindow.astro";
import {
  isConfigured,
  professionalLinks,
} from "../../config/site";
import { isLocale, localeStaticPaths, ui } from "../../i18n";

export const getStaticPaths = (() => localeStaticPaths()) satisfies GetStaticPaths;

const lang = isLocale(Astro.params.lang) ? Astro.params.lang : "en";
const t = ui(lang).contact;

const connections = professionalLinks().map((item) => ({
  ...item,
  label: t[item.key],
  icon:
    item.key === "email"
      ? "✉"
      : item.key === "github"
        ? "</>"
        : item.key === "linkedin"
          ? "in"
          : "Md",
}));
---

<BaseLayout title={t.title} description={t.metaDescription}>
  <div class="page-stack contact-page">
    <XPWindow title={t.title}>
      <div class="contact-intro">
        <p class="contact-intro__eyebrow">{t.eyebrow}</p>
        <h1>{t.heading}</h1>
        <p>{t.intro}</p>
      </div>
    </XPWindow>

    <XPWindow title={t.controlTitle}>
      <ul class="connections">
        {
          connections.map((item) => {
            const ready = isConfigured(item.detail);

            return (
              <li>
                {
                  ready ? (
                    <a
                      class="connections__item"
                      href={item.href}
                      target={item.external ? "_blank" : undefined}
                      rel={item.external ? "noopener noreferrer" : undefined}
                      aria-label={
                        item.external
                          ? `${item.label} ${t.newTab}`
                          : item.label
                      }
                    >
                      <span class="connections__icon" aria-hidden="true">
                        {item.icon}
                      </span>
                      <span>
                        <strong>{item.label}</strong>
                        <span class="connections__detail">{item.detail}</span>
                      </span>
                    </a>
                  ) : (
                    <div class="connections__item connections__item--pending">
                      <span class="connections__icon" aria-hidden="true">
                        {item.icon}
                      </span>
                      <span>
                        <strong>{item.label}</strong>
                        <span class="connections__detail">
                          {t.pending}
                        </span>
                      </span>
                    </div>
                  )
                }
              </li>
            );
          })
        }
      </ul>
    </XPWindow>

    <XPWindow title={t.availabilityTitle}>
      <p class="availability">
        {t.availability}
      </p>
    </XPWindow>
  </div>
</BaseLayout>

<style>
  .contact-intro {
    padding: 8px clamp(2px, 3vw, 24px);
  }

  .contact-intro__eyebrow {
    margin: 0 0 8px;
    color: var(--xp-heading);
    font-size: 13px;
    font-weight: 700;
  }

  .contact-intro h1 {
    max-width: 760px;
    margin: 0 0 12px;
    font-size: clamp(26px, 5vw, 40px);
    line-height: 1.1;
  }

  .contact-intro p {
    max-width: 680px;
    margin: 0;
    color: var(--xp-muted-text);
    line-height: 1.65;
  }

  .connections {
    margin: 0;
    padding: 4px;
    list-style: none;
    display: grid;
    gap: 10px;
  }

  .connections__item {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 14px;
    align-items: center;
    padding: 14px 16px;
    border: 1px solid var(--xp-border-mid);
    background: var(--xp-contact-card);
    color: inherit;
    text-decoration: none;
  }

  a.connections__item:hover,
  a.connections__item:focus-visible {
    border-color: var(--xp-input-border);
    background: var(--xp-list-hover);
    outline: none;
  }

  a.connections__item:focus-visible {
    outline: 2px solid var(--xp-focus);
    outline-offset: 2px;
  }

  .connections__item--pending {
    color: var(--xp-muted-text);
  }

  .connections__icon {
    width: 42px;
    height: 42px;
    display: grid;
    place-items: center;
    border: 1px solid var(--xp-input-border);
    background: var(--xp-chip-bg);
    color: var(--xp-caption);
    font-size: 14px;
    font-weight: 700;
  }

  .connections__item strong {
    display: block;
    margin-bottom: 3px;
  }

  .connections__detail {
    display: block;
    overflow: hidden;
    color: var(--xp-muted-text);
    font-size: 13px;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .availability {
    max-width: 680px;
    margin: 0;
    padding: 8px clamp(2px, 3vw, 24px);
    color: var(--xp-muted-text);
    line-height: 1.65;
  }

  @media (max-width: 560px) {
    .connections__detail {
      white-space: normal;
    }
  }
</style>

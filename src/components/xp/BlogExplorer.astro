---
import XPWindow from "./XPWindow.astro";
import {
  getPostHref,
  postLocale,
  type BlogPost,
} from "../../lib/blog";
import {
  formatDate,
  getLocaleFromPath,
  interpolate,
  localizeHref,
  ui,
} from "../../i18n";

interface Props {
  posts: BlogPost[];
}

const { posts } = Astro.props;
const isDev = import.meta.env.DEV;
const locale = getLocaleFromPath(Astro.url.pathname);
const t = ui(locale);
const menu = [
  t.explorer.file,
  t.explorer.edit,
  t.explorer.view,
  t.explorer.favorites,
  t.explorer.tools,
  t.explorer.help,
];
const hasForeignPosts = posts.some((post) => postLocale(post) !== locale);
---

<XPWindow title={t.notes.title}>
  <div class="explorer">
    <div class="explorer__toolbar">
      {
        menu.map((item) => (
          <button
            type="button"
            data-xp-dialog-open="chrome-menu"
            aria-haspopup="dialog"
            aria-controls="chrome-menu"
          >
            {item}
          </button>
        ))
      }
    </div>

    <div class="explorer__address">
      <span class="explorer__address-label">{t.explorer.address}</span>
      <div class="explorer__address-bar">
        {t.notes.address}
      </div>
    </div>

    <div class="explorer__body">
      <aside class="explorer__sidebar">
        <section>
          <h3>{t.explorer.noteTasks}</h3>
          <a href={localizeHref(locale, "/blog")}>{t.explorer.allNotes}</a>
          <a href={localizeHref(locale, "/projects")}>{t.nav.projects}</a>
        </section>

        <section>
          <h3>{t.explorer.otherPlaces}</h3>
          <a href={localizeHref(locale, "/about")}>{t.nav.about}</a>
          <a href={localizeHref(locale, "/streams")}>{t.nav.streams}</a>
          <a href={localizeHref(locale, "/contact")}>{t.nav.contact}</a>
        </section>
      </aside>

      <div class="explorer__content">
        <header class="explorer__intro">
          <h1>{t.notes.title}</h1>
          <p>{t.notes.intro}</p>
          {hasForeignPosts ? <p>{t.notes.englishOnly}</p> : null}
        </header>

        <div class="notes__toolbar">
          <span>{t.notes.name}</span>
          <span>{t.notes.category}</span>
          <span>{t.notes.date}</span>
          <span>{t.notes.tags}</span>
        </div>

        {
          posts.length === 0 ? (
            <p class="notes__empty">{t.notes.empty}</p>
          ) : (
            <div class="notes__list">
              {posts.map((post) => (
                <a class="notes__row" href={getPostHref(post)}>
                  <span class="notes__title">
                    <span aria-hidden="true">📄</span>
                    {post.data.title}
                    {isDev && post.data.draft ? (
                      <span class="notes__draft">{t.notes.draft}</span>
                    ) : null}
                  </span>
                  <span>{post.data.category}</span>
                  <span>{formatDate(post.data.publishDate, locale)}</span>
                  <span class="notes__tags">
                    {post.data.tags.length > 0
                      ? post.data.tags.join(", ")
                      : "—"}
                  </span>
                </a>
              ))}
            </div>
          )
        }
      </div>
    </div>

    <div class="explorer__statusbar">
      <span>{interpolate(t.explorer.items, { n: posts.length })}</span>
      <span>{t.explorer.myComputer}</span>
    </div>
  </div>
</XPWindow>

<style>
  .explorer {
    margin: -22px;
    background: var(--xp-content-bg);
  }

  .explorer__toolbar {
    min-height: 30px;
    display: flex;
    align-items: center;
    gap: 18px;
    padding: 4px 10px;
    background: var(--xp-panel);
    border-bottom: 1px solid var(--xp-panel-border);
    color: var(--xp-text);
    font-size: 12px;
  }

  .explorer__toolbar button {
    padding: 0;
    border: 0;
    background: none;
    color: inherit;
    font: inherit;
    cursor: pointer;
  }

  .explorer__toolbar button:focus-visible {
    outline: 2px solid var(--xp-focus);
    outline-offset: 2px;
  }

  .explorer__address {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 8px;
    align-items: center;
    min-height: 34px;
    padding: 4px 7px;
    background: var(--xp-panel);
    border-bottom: 1px solid var(--xp-panel-border);
  }

  .explorer__address-label {
    color: var(--xp-muted-text);
    font-size: 12px;
  }

  .explorer__address-bar {
    min-width: 0;
    overflow: hidden;
    padding: 4px 8px;
    border: 1px solid var(--xp-input-border);
    background: var(--xp-content-bg);
    white-space: nowrap;
    text-overflow: ellipsis;
    font-size: 12px;
  }

  .explorer__body {
    display: grid;
    grid-template-columns: 210px minmax(0, 1fr);
    min-height: 390px;
  }

  .explorer__sidebar {
    padding: 18px 12px;
    background: var(--xp-explorer-sidebar);
  }

  .explorer__sidebar section {
    overflow: hidden;
    margin-bottom: 14px;
    border-radius: 4px;
    background: var(--xp-content-bg);
  }

  .explorer__sidebar h3 {
    margin: 0;
    padding: 8px 10px;
    color: var(--xp-explorer-blue);
    background: var(--xp-explorer-heading);
    font-size: 13px;
  }

  .explorer__sidebar a {
    display: block;
    padding: 5px 10px;
    color: var(--xp-explorer-blue-mid);
    text-decoration: none;
    font-size: 12px;
  }

  .explorer__sidebar a:hover {
    text-decoration: underline;
  }

  .explorer__content {
    min-width: 0;
    background: var(--xp-content-bg);
  }

  .explorer__intro {
    padding: 18px 16px 14px;
    border-bottom: 1px solid var(--xp-hairline);
  }

  .explorer__intro h1 {
    margin: 0 0 8px;
    font-size: clamp(22px, 4vw, 30px);
    line-height: 1.15;
  }

  .explorer__intro p {
    max-width: 640px;
    margin: 0;
    color: var(--xp-muted-text);
    font-size: 14px;
    line-height: 1.6;
  }

  .notes__toolbar,
  .notes__row {
    display: grid;
    grid-template-columns:
      minmax(0, 1.8fr)
      minmax(110px, 0.7fr)
      110px
      minmax(90px, 0.9fr);
    gap: 12px;
    align-items: center;
  }

  .notes__toolbar {
    padding: 7px 12px;
    background: var(--xp-panel);
    border-bottom: 1px solid var(--xp-panel-border);
    color: var(--xp-muted-text);
    font-size: 12px;
    font-weight: 700;
  }

  .notes__row {
    padding: 12px;
    border-bottom: 1px solid var(--xp-hairline);
    color: var(--xp-text);
    text-decoration: none;
    font-size: 13px;
  }

  .notes__row:hover,
  .notes__row:focus-visible {
    background: var(--xp-list-hover);
    outline: none;
  }

  .notes__title {
    min-width: 0;
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 8px;
    color: var(--xp-link);
    font-weight: 700;
  }

  .notes__draft {
    padding: 1px 6px;
    border: 1px solid var(--xp-input-border);
    background: var(--xp-chip-bg);
    color: var(--xp-chip-text);
    font-size: 10px;
    font-weight: 700;
    text-transform: uppercase;
  }

  .notes__tags {
    min-width: 0;
    overflow: hidden;
    color: var(--xp-muted-text);
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .notes__empty {
    margin: 0;
    padding: 28px 16px;
    color: var(--xp-muted-text);
    font-size: 13px;
  }

  .explorer__statusbar {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    padding: 4px 8px;
    background: var(--xp-panel);
    border-top: 1px solid var(--xp-statusbar-border);
    color: var(--xp-muted-text);
    font-size: 11px;
  }

  @media (max-width: 820px) {
    .explorer__body {
      grid-template-columns: 1fr;
    }

    .explorer__sidebar {
      display: none;
    }
  }

  @media (max-width: 720px) {
    .notes__toolbar {
      display: none;
    }

    .notes__row {
      grid-template-columns: 1fr;
      gap: 6px;
    }

    .notes__row > span:not(.notes__title) {
      color: var(--xp-muted-text);
      font-size: 12px;
      white-space: normal;
    }
  }

  @media (max-width: 560px) {
    .explorer {
      margin: -18px;
    }

    .explorer__toolbar {
      overflow-x: auto;
      gap: 14px;
      white-space: nowrap;
    }
  }
</style>

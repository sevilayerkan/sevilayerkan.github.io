---
import XPWindow from "./XPWindow.astro";
import XPDialog from "./XPDialog.astro";
import XPButton from "./XPButton.astro";
import {
  projectDialogId,
  projectHref,
  projects,
} from "../../data/projects";
import {
  getLocaleFromPath,
  interpolate,
  localizeHref,
  ui,
} from "../../i18n";

const locale = getLocaleFromPath(Astro.url.pathname);
const t = ui(locale);
const menu = [
  t.explorer.file,
  t.explorer.edit,
  t.explorer.view,
  t.explorer.favorites,
  t.explorer.tools,
  t.explorer.help,
];
---

<XPWindow title={t.projectsPage.explorerTitle}>
  <div class="explorer">
    <div class="explorer__toolbar">
      {
        menu.map((item) => (
          <button
            type="button"
            data-xp-dialog-open="chrome-menu"
            aria-haspopup="dialog"
            aria-controls="chrome-menu"
          >
            {item}
          </button>
        ))
      }
    </div>

    <div class="explorer__address">
      <span class="explorer__address-label">{t.explorer.address}</span>
      <div class="explorer__address-bar">
        {t.projectsPage.explorerTitle}
      </div>
    </div>

    <div class="explorer__body">
      <aside class="explorer__sidebar">
        <section>
          <h3>{t.explorer.projectTasks}</h3>
          <a href={localizeHref(locale, "/projects")}>{t.explorer.viewAllProjects}</a>
          <a href={localizeHref(locale, "/about")}>{t.explorer.aboutPortfolio}</a>
        </section>

        <section>
          <h3>{t.explorer.otherPlaces}</h3>
          <a href={localizeHref(locale, "/blog")}>{t.notes.title}</a>
          <a href={localizeHref(locale, "/streams")}>{t.nav.streams}</a>
          <a href={localizeHref(locale, "/contact")}>{t.nav.contact}</a>
        </section>
      </aside>

      <div class="explorer__content">
        {
          projects.map((project) => (
            <button
              class="project-file"
              type="button"
              data-xp-dialog-open={projectDialogId(project.id)}
              aria-haspopup="dialog"
              aria-controls={projectDialogId(project.id)}
            >
              <div class="project-file__icon" aria-hidden="true">
                {project.icon}
              </div>

              <div class="project-file__copy">
                <span class="project-file__name">{project.title}</span>
                <p class="project-file__type">{project.type}</p>
                <p class="project-file__description">{project.summary}</p>
              </div>
            </button>
          ))
        }
      </div>
    </div>

    <div class="explorer__statusbar">
      <span>{interpolate(t.explorer.objects, { n: projects.length })}</span>
      <span>{t.explorer.myComputer}</span>
    </div>
  </div>
</XPWindow>

{
  projects.map((project) => (
    <XPDialog
      id={projectDialogId(project.id)}
      title={interpolate(t.projectsPage.properties, { name: project.title })}
    >
      <div class="project-props">
        <p class="project-props__meta">
          <span>{t.projectsPage.type}: {project.type}</span>
          <span>
            {t.projectsPage.status}:{" "}
            {t.projectStatus[project.status as keyof typeof t.projectStatus] ??
              project.status}
          </span>
        </p>
        <p>{project.summary}</p>
        <div>
          <h3>{t.projectsPage.technologies}</h3>
          <p>{project.stack.join(" • ")}</p>
        </div>
      </div>

      <Fragment slot="footer">
        <XPButton href={projectHref(project.id, locale)} variant="primary">
          {t.projectsPage.open}
        </XPButton>
        {project.github ? (
          <XPButton href={project.github} external>
            GitHub
          </XPButton>
        ) : null}
      </Fragment>
    </XPDialog>
  ))
}

<style>
  .explorer {
    margin: -22px;
    background: var(--xp-content-bg);
  }

  .explorer__toolbar {
    min-height: 30px;
    display: flex;
    align-items: center;
    gap: 18px;
    padding: 4px 10px;
    background: var(--xp-panel);
    border-bottom: 1px solid var(--xp-panel-border);
    color: var(--xp-text);
    font-size: 12px;
  }

  .explorer__toolbar button {
    padding: 0;
    border: 0;
    background: none;
    color: inherit;
    font: inherit;
    cursor: pointer;
  }

  .explorer__toolbar button:focus-visible {
    outline: 2px solid var(--xp-focus);
    outline-offset: 2px;
  }

  .explorer__address {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 8px;
    align-items: center;
    min-height: 34px;
    padding: 4px 7px;
    background: var(--xp-panel);
    border-bottom: 1px solid var(--xp-panel-border);
  }

  .explorer__address-label {
    color: var(--xp-muted-text);
    font-size: 12px;
  }

  .explorer__address-bar {
    min-width: 0;
    overflow: hidden;
    padding: 4px 8px;
    border: 1px solid var(--xp-input-border);
    background: var(--xp-content-bg);
    white-space: nowrap;
    text-overflow: ellipsis;
    font-size: 12px;
  }

  .explorer__body {
    display: grid;
    grid-template-columns: 210px minmax(0, 1fr);
    min-height: 390px;
  }

  .explorer__sidebar {
    padding: 18px 12px;
    background: var(--xp-explorer-sidebar);
  }

  .explorer__sidebar section {
    overflow: hidden;
    margin-bottom: 14px;
    border-radius: 4px;
    background: var(--xp-content-bg);
  }

  .explorer__sidebar h3 {
    margin: 0;
    padding: 8px 10px;
    color: var(--xp-explorer-blue);
    background: var(--xp-explorer-heading);
    font-size: 13px;
  }

  .explorer__sidebar a {
    display: block;
    padding: 5px 10px;
    color: var(--xp-explorer-blue-mid);
    text-decoration: none;
    font-size: 12px;
  }

  .explorer__sidebar a:hover {
    text-decoration: underline;
  }

  .explorer__content {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 14px;
    align-content: start;
    padding: 24px;
    background: var(--xp-content-bg);
  }

  .project-file {
    display: grid;
    justify-items: center;
    gap: 8px;
    width: 100%;
    min-height: 210px;
    padding: 18px 14px;
    border: 1px solid transparent;
    background: transparent;
    color: var(--xp-button-text);
    text-align: center;
    text-decoration: none;
  }

  .project-file:hover,
  .project-file:focus-visible {
    border-color: var(--xp-input-border);
    background: var(--xp-list-hover);
  }

  .project-file:focus-visible {
    outline: 2px solid var(--xp-focus);
    outline-offset: 2px;
  }

  .project-file__icon {
    width: 72px;
    height: 72px;
    display: grid;
    place-items: center;
    font-size: 46px;
    filter: drop-shadow(1px 2px rgba(0, 0, 0, 0.12));
  }

  .project-file__copy h3,
  .project-file__name {
    margin: 0;
    color: var(--xp-link);
    font-size: 14px;
    font-weight: 700;
  }

  .project-file__type {
    margin: 5px 0 0;
    color: var(--xp-muted-text);
    font-size: 12px;
    font-weight: 700;
  }

  .project-file__description {
    margin: 7px auto 0;
    max-width: 220px;
    color: var(--xp-muted-text);
    font-size: 12px;
    line-height: 1.45;
  }

  .explorer__statusbar {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    padding: 4px 8px;
    background: var(--xp-panel);
    border-top: 1px solid var(--xp-statusbar-border);
    color: var(--xp-muted-text);
    font-size: 11px;
  }

  @media (max-width: 820px) {
    .explorer__body {
      grid-template-columns: 1fr;
    }

    .explorer__sidebar {
      display: none;
    }

    .explorer__content {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 560px) {
    .explorer {
      margin: -18px;
    }

    .explorer__toolbar {
      overflow-x: auto;
      gap: 14px;
      white-space: nowrap;
    }

    .explorer__content {
      grid-template-columns: 1fr;
      padding: 14px;
    }

    .project-file {
      min-height: 0;
      grid-template-columns: auto 1fr;
      justify-items: start;
      align-items: center;
      text-align: left;
      padding: 12px;
    }

    .project-file__icon {
      width: 56px;
      height: 56px;
      font-size: 36px;
    }

    .project-file__description {
      max-width: none;
    }
  }

  .project-props {
    display: grid;
    gap: 14px;
  }

  .project-props p {
    margin: 0;
  }

  .project-props__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 16px;
    color: var(--xp-muted-text);
    font-weight: 700;
  }

  .project-props h3 {
    margin: 0 0 4px;
    color: var(--xp-heading);
    font-size: 12px;
    text-transform: uppercase;
    letter-spacing: 0.03em;
  }
</style>

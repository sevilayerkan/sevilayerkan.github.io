---
interface Props {
  dialog: string;
  class?: string;
}

const { dialog, class: className = "" } = Astro.props;
---

<button
  class:list={["xp-dialog-trigger", className]}
  type="button"
  data-xp-dialog-open={dialog}
  aria-haspopup="dialog"
  aria-controls={dialog}
>
  <slot />
</button>

<style>
  .xp-dialog-trigger {
    padding: 0;
    border: 0;
    background: none;
    font: inherit;
    color: inherit;
    text-align: inherit;
    cursor: pointer;
  }

  .xp-dialog-trigger:focus-visible {
    outline: 2px solid var(--xp-focus);
    outline-offset: 2px;
  }
</style>

---
import "../styles/global.css";
import XPNav from "../components/xp/XPNav.astro";
import XPTaskbar from "../components/xp/XPTaskbar.astro";
import ChromeDialogs from "../components/xp/ChromeDialogs.astro";
import DisplayProperties from "../components/xp/DisplayProperties.astro";
import RegionalOptions from "../components/xp/RegionalOptions.astro";
import RunDialog from "../components/xp/RunDialog.astro";
import ConsoleDialog from "../components/xp/ConsoleDialog.astro";
import { siteConfig } from "../config/site";
import {
  canonicalFromPathname,
  defaultHreflangUrl,
  localePageUrl,
  ogLocale,
  pageDocumentTitle,
  resolveOgImage,
  toAbsoluteUrl,
} from "../lib/seo";
import {
  defaultLocale,
  getLocaleFromPath,
  locales,
  stripLocale,
  ui,
  type Locale,
} from "../i18n";

interface Props {
  title?: string;
  titleAsIs?: boolean;
  description?: string;
  canonicalUrl?: string;
  ogImage?: string | null;
  ogType?: "website" | "article";
  publishedTime?: Date;
  updatedTime?: Date;
  chrome?: boolean;
  robots?: string;
  themeColor?: string;
  themeColorDark?: string;
  availableLocales?: Locale[];
  localeFallback?: string;
  localeHrefs?: Partial<Record<Locale, string>>;
}

const {
  title = siteConfig.title,
  titleAsIs = false,
  description = siteConfig.defaultDescription,
  canonicalUrl,
  ogImage,
  ogType = "website",
  publishedTime,
  updatedTime,
  chrome = true,
  robots,
  themeColor = "#245edb",
  themeColorDark = "#163d90",
  availableLocales = [...locales],
  localeFallback,
  localeHrefs,
} = Astro.props;

const locale = getLocaleFromPath(Astro.url.pathname);
const t = ui(locale);
const pathKey = stripLocale(Astro.url.pathname);

const pageTitle = pageDocumentTitle(title, { asIs: titleAsIs });

const canonical = canonicalUrl
  ? /^https?:\/\//i.test(canonicalUrl)
    ? canonicalUrl
    : canonicalFromPathname(canonicalUrl)
  : canonicalFromPathname(Astro.url.pathname);

const ogImageUrl = resolveOgImage(ogImage);
const hasOgImage = Boolean(ogImageUrl);

const skipHref = "#main-content";

const hreflangLocales = chrome ? availableLocales : [];
const hrefForLocale = (alt: Locale): string => {
  const mapped = localeHrefs?.[alt];
  return mapped ? toAbsoluteUrl(mapped) : localePageUrl(alt, pathKey);
};
const defaultHref = chrome
  ? localeHrefs
    ? hrefForLocale(
        hreflangLocales.includes(defaultLocale) ? defaultLocale : locale,
      )
    : defaultHreflangUrl(hreflangLocales, pathKey, locale)
  : undefined;
const localePathsJson = localeHrefs ? JSON.stringify(localeHrefs) : undefined;
---

<!doctype html>
<html
  lang={locale}
  data-available-locales={availableLocales.join(",")}
  data-locale-fallback={localeFallback}
  data-locale-paths={localePathsJson}
>
  <head>
    <meta charset="UTF-8" />
    <script is:inline>
      (function () {
        var key = "xp-theme";
        var theme = null;
        try {
          theme = localStorage.getItem(key);
        } catch (error) {}
        if (theme !== "xp-light" && theme !== "xp-dark") {
          theme = window.matchMedia("(prefers-color-scheme: dark)").matches
            ? "xp-dark"
            : "xp-light";
        }
        document.documentElement.setAttribute("data-theme", theme);
        document.documentElement.style.colorScheme =
          theme === "xp-dark" ? "dark" : "light";
      })();
    </script>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    {robots ? <meta name="robots" content={robots} /> : null}
    <meta
      name="theme-color"
      content={themeColor}
      data-theme-color-light={themeColor}
      data-theme-color-dark={themeColorDark}
    />
    <script is:inline>
      (function () {
        var meta = document.querySelector('meta[name="theme-color"]');
        var theme = document.documentElement.getAttribute("data-theme");
        if (!meta) return;
        var light = meta.getAttribute("data-theme-color-light") || "#245edb";
        var dark = meta.getAttribute("data-theme-color-dark") || "#163d90";
        if (theme === "xp-dark") meta.setAttribute("content", dark);
        if (theme === "xp-light") meta.setAttribute("content", light);
      })();
    </script>
    <title>{pageTitle}</title>
    <slot name="head" />
    <!-- TODO: add public/favicon.ico when you have a raster icon -->
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    {canonical ? <link rel="canonical" href={canonical} /> : null}
    {
      hreflangLocales.map((alt) => (
        <link rel="alternate" hreflang={alt} href={hrefForLocale(alt)} />
      ))
    }
    {
      defaultHref ? (
        <link rel="alternate" hreflang="x-default" href={defaultHref} />
      ) : null
    }
    <meta property="og:site_name" content={siteConfig.name} />
    <meta property="og:locale" content={ogLocale(locale)} />
    {
      hreflangLocales
        .filter((alt) => alt !== locale)
        .map((alt) => (
          <meta property="og:locale:alternate" content={ogLocale(alt)} />
        ))
    }
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    {canonical ? <meta property="og:url" content={canonical} /> : null}
    {hasOgImage ? <meta property="og:image" content={ogImageUrl} /> : null}
    {
      hasOgImage ? (
        <meta property="og:image:alt" content={siteConfig.name} />
      ) : null
    }
    <meta
      name="twitter:card"
      content={hasOgImage ? "summary_large_image" : "summary"}
    />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    {hasOgImage ? <meta name="twitter:image" content={ogImageUrl} /> : null}
    {
      hasOgImage ? (
        <meta name="twitter:image:alt" content={siteConfig.name} />
      ) : null
    }
    {
      publishedTime ? (
        <meta
          property="article:published_time"
          content={publishedTime.toISOString()}
        />
      ) : null
    }
    {
      updatedTime ? (
        <meta
          property="article:modified_time"
          content={updatedTime.toISOString()}
        />
      ) : null
    }
  </head>

  <body class:list={[{ "layout-bsod": !chrome }]}>
    {
      chrome ? (
        <div class="site-shell">
          <a class="skip-link" href={skipHref}>
            {t.meta.skipToContent}
          </a>

          <div class="site-container">
            <XPNav />
          </div>

          <main id="main-content">
            <div class="site-container">
              <slot />
            </div>
          </main>

          <XPTaskbar />
          <ChromeDialogs />
          <DisplayProperties />
          <RegionalOptions />
          <ConsoleDialog />
          <RunDialog />
        </div>
      ) : (
        <slot />
      )
    }
  </body>
</html>

<style>
  .site-shell {
    min-height: 100vh;
    padding-top: 20px;
  }

  @media (max-width: 640px) {
    .site-shell {
      padding-top: 10px;
    }
  }
</style>
